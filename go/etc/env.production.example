# Copy values into your deployment secret manager. Do not commit real values.

# App
ASTRAQUANT_CORS_ORIGIN=https://your-frontend.example.com

# LLM provider
ZENMUX_API_KEY=replace-with-real-llm-key

# Database and Redis
Postgres__DataSource=postgres://nof0:replace-with-db-password@db.example.com:5432/nof0?sslmode=require&default_query_exec_mode=simple_protocol
Postgres__MaxOpen=25
Postgres__MaxIdle=10
Postgres__MaxLifetime=5m
Cache__0__Host=redis.example.com:6379
Cache__0__Type=node
Cache__0__Pass=replace-with-redis-password
Cache__0__Tls=true
Cache__0__User=default

# Hyperliquid testnet signer. Prefer scoped ASTRAQUANT_SECRET_* variables.
ASTRAQUANT_TRADER_ID=prod_testnet_trader
ASTRAQUANT_SESSION_ID=prod_session
ASTRAQUANT_SECRET_PROD_TESTNET_TRADER_PROD_SESSION_HYPERLIQUID_PRIVATE_KEY=replace-with-hex-private-key
HYPERLIQUID_MAIN_ADDRESS=0x0000000000000000000000000000000000000000
HYPERLIQUID_VAULT_ADDRESS=

# Live trading requires a deliberate config change from testnet to live and these ACKs.
# ASTRAQUANT_ALLOW_LIVE_TRADING=true
# ASTRAQUANT_LIVE_TRADING_ACK=I_UNDERSTAND_THIS_CAN_LOSE_MONEY
